<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Talking to the API and uploading photos. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- A workshop phone may well have no camera; the gallery still works, so
         the camera is declared optional rather than a hard requirement that
         would hide the app on the Play Store for those devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Location, for two things: sorting the garage directory by how near each
         workshop is, and reporting a driver's position while a delivery is on
         the way.

         FINE and COARSE only. Deliberately no ACCESS_BACKGROUND_LOCATION:
         tracking runs while the driver has the screen open and stops when they
         leave it. A delivery run does not justify following someone's phone
         while the app is closed, and asking for that permission would be asking
         for far more than the feature needs.

         GPS is declared optional at the feature level. A customer who never
         shares a position still gets the whole app, only with an alphabetical
         directory instead of a nearest-first one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <!-- Telling the customer their car is ready, and the mechanic that a job
         landed on them. Required from Android 13 (API 33); below that,
         notifications are allowed without asking for anything.

         Asked for when the first signed-in session starts polling, not at
         launch. A permission prompt on the login screen has no context behind
         it, and "Allow notifications?" before anybody has said who they are is
         the one most likely to be refused for good.

         POST_NOTIFICATIONS alone. No SCHEDULE_EXACT_ALARM or wake locks:
         nothing here is scheduled, every alert is raised in response to
         something the server has already recorded. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- networkSecurityConfig: the API runs over plain HTTP in development
         (localhost:5100), and Android has blocked cleartext since API 28.
         Without it every request fails with a bare connection error that reads
         as "the server is down".

         network_security_config.xml permits cleartext ONLY for local
         development addresses. Anything else — including your production
         host — still requires HTTPS. -->
    <application
        android:label="GarageFlow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
