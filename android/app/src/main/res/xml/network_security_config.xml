<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted for local development hosts only.

  The GarageFlow API runs on http://localhost:5100 while you are building, and
  Android blocks cleartext by default from API 28 onwards — so without this the
  app cannot reach a server that is plainly running, and the failure looks like
  a network fault rather than a policy one.

  The exemption is a fixed list, not `cleartextTrafficPermitted="true"` on the
  base config. A deployed build talking to a real host still requires HTTPS,
  which is what you want the day this ships.

    10.0.2.2   the Android emulator's alias for your machine
    127.0.0.1  a device port-forwarded with `adb reverse`
    localhost  the same, by name

  Testing on a real phone over wifi? Add your machine's LAN address here, and
  pass it as the API_BASE_URL dart-define when you run:

    flutter run "-dart-define=API_BASE_URL=http://192.168.x.x:5100"

  (Two leading dashes on that flag, written here as one: a pair of dashes is
  illegal inside an XML comment and the Android resource parser rejects the
  whole file for it.)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>

        <!-- This machine's LAN address, for testing on a real phone over wifi.
             Your router may hand out a different one after a reboot — check
             with `ipconfig` and update this if the app suddenly cannot
             connect. -->
        <domain includeSubdomains="false">192.168.1.97</domain>
    </domain-config>
</network-security-config>
