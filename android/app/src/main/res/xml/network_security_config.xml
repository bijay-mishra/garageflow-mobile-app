<?xml version="1.0" encoding="utf-8"?>
<!--
  Which hosts the app is allowed to reach over plain HTTP.

  Android blocks cleartext from API 28 onwards. Without an entry here a server
  that is plainly running is simply unreachable, and the failure surfaces as a
  network fault rather than a policy one, which sends you looking in the wrong
  place.

  The exemption is a fixed list, not `cleartextTrafficPermitted="true"` on the
  base config. Anything not named below still requires HTTPS, so a stray host
  cannot quietly downgrade the app.

    10.0.2.2      the Android emulator's alias for your machine
    127.0.0.1     a device port-forwarded with `adb reverse`
    localhost     the same, by name
    192.168.1.97  this PC's LAN address, for a phone on the same wifi

  A domain entry covers every port, so a port number never appears here.

  Every entry left is a development address on this machine. The live API is
  https://app.bijayamishra.com.np and is NOT listed, which is the point: the
  release build can only reach it over TLS, and no production traffic can
  quietly fall back to cleartext. Do not add it back — if the app cannot reach
  the server, the certificate is the thing to fix, not this file.

  Testing against a server not in this list? Add it here as well as passing it
  as the API_BASE_URL dart-define, or the request never leaves the phone:

    flutter run "-dart-define=API_BASE_URL=http://192.168.x.x:5100"

  (Two leading dashes on that flag, written here as one: a pair of dashes is
  illegal inside an XML comment and the Android resource parser rejects the
  whole file for it.)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>

        <!-- This machine's LAN address, for testing on a real phone over wifi.
             Your router may hand out a different one after a reboot — check
             with `ipconfig` and update this if the app suddenly cannot
             connect. -->
        <domain includeSubdomains="false">192.168.1.97</domain>
    </domain-config>
</network-security-config>
