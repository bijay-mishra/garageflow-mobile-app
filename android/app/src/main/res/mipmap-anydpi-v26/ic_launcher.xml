<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon, used from Android 8 onward.

  The launcher masks the foreground to whatever shape the device uses — circle,
  squircle, rounded square — and crops roughly the outer quarter. So the spanner
  is drawn inset inside a transparent square (see tool/make_icon.js) and the
  brand blue is supplied here as a flat background rather than being baked into
  the same layer. Older devices fall back to the square ic_launcher.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
